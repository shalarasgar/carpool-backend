# Copy to .env for local runs. .env is gitignored.

APP_NAME=Ýolugra
PORT=8080
DEV_MODE=true
# Take client IPs from X-Forwarded-For (per-IP OTP limits). Turn on only behind a reverse
# proxy that is the sole way to reach the API, as in deploy/docker-compose.yml.
TRUST_PROXY=false

# Local Postgres from docker-compose.yml. The app container uses hostname "postgres" instead of localhost.
DATABASE_URL=postgres://carpool:carpool@localhost:5432/carpool?sslmode=disable

# Replace these before any shared or production deployment. Minimum length is 16 characters.
JWT_SECRET=replace-with-a-long-random-string
OTP_HMAC_SECRET=replace-with-a-different-long-random-string
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Apply SQL migrations when the process starts. docker-compose sets this to true.
MIGRATE_ON_START=false

# pgx pool
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m

# HTTP server
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s

# OTP and SMS gateway. Defaults match the project spec when these are omitted.
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_PHONE_INTERVAL=1m
OTP_PHONE_DAILY_MAX=5
OTP_IP_HOURLY_MAX=30
OTP_DEVICE_HOURLY_MAX=10
OTP_MOBILE_PREFIXES=6,7
# Comma-separated test numbers that skip every OTP rate limit. Leave empty in production.
OTP_TEST_PHONES=
# App-store review login: this one number always accepts this 6-digit code and gets no SMS,
# so a reviewer abroad can sign in. Use a number you own and a code that is not obvious.
# Anyone who knows the pair can open that account, so keep nothing real in it and leave both
# empty when no review is in progress.
OTP_REVIEW_PHONE=
OTP_REVIEW_CODE=
SMS_MAX_ATTEMPTS=3
SMS_LEASE=60s
SMS_SENDING_LEASE=3m
GATEWAY_RATE_PER_MIN=120
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Product rules. Search dates and times are interpreted in APP_TIMEZONE.
APP_TIMEZONE=Asia/Ashgabat
# Minimum gap between two trips of the same driver (overlap check).
TRIP_OVERLAP_BUFFER=30m
# A departed trip completes automatically this long after its planned arrival.
TRIP_COMPLETE_GRACE=6h
# Drivers and accepted passengers get one reminder this long before departure.
TRIP_REMIND_BEFORE=2h
# Uploaded profile and vehicle photos (served at /media/).
MEDIA_DIR=./media
# Requests per minute per signed-in user on /v1 product endpoints.
API_RATE_PER_MIN=120

# Push notifications (Firebase Cloud Messaging). Path to a service account key from
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# The key is a secret: keep it in ./secrets/ (gitignored). Empty turns pushes off.
FCM_CREDENTIALS_FILE=
# How often new inbox rows are sent, and the age after which a backlog is not sent.
PUSH_INTERVAL=3s
PUSH_MAX_AGE=30m
# Device tokens the app has not refreshed for this long are removed (60 days).
PUSH_TOKEN_TTL=1440h
