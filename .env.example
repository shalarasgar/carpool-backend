# Copy to .env for local runs. .env is gitignored.

APP_NAME=carpool
PORT=8080
DEV_MODE=true

# Local Postgres from docker-compose.yml. The app container uses hostname "postgres" instead of localhost.
DATABASE_URL=postgres://carpool:carpool@localhost:5432/carpool?sslmode=disable

# Replace these before any shared or production deployment. Minimum length is 16 characters.
JWT_SECRET=replace-with-a-long-random-string
OTP_HMAC_SECRET=replace-with-a-different-long-random-string
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Apply SQL migrations when the process starts. docker-compose sets this to true.
MIGRATE_ON_START=false

# Phone validation: digits allowed right after +993 (comma separated). "6,7" = Turkmen mobile ranges.
ALLOWED_PHONE_PREFIXES=6,7

# OTP lifetime, wrong-attempt limit and rate limits.
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_PHONE_COOLDOWN=60s
OTP_PHONE_DAILY_LIMIT=5
OTP_IP_LIMIT=30
OTP_IP_WINDOW=1h
OTP_DEVICE_LIMIT=10
OTP_DEVICE_WINDOW=1h
# Only "memory" is implemented. The limiter is behind an interface for Redis later.
RATE_LIMITER=memory

# Tokens
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# SMS: "queue" writes to sms_queue for the Android gateway; "noop" drops messages (use with DEV_MODE=true).
SMS_PROVIDER=queue
SMS_MAX_ATTEMPTS=3
SMS_LOCK_DURATION=60s
SMS_GATEWAY_HEALTHY_WINDOW=30s
SMS_GATEWAY_MAX_BATCH=50

# Background maintenance (stuck SMS, expired OTPs and refresh tokens).
JOBS_INTERVAL=30s

# Profile photos. Types are sniffed from the file bytes, not the multipart header.
PHOTO_MAX_BYTES=2097152
PHOTO_ALLOWED_TYPES=image/jpeg,image/png,image/webp
PHOTO_DIR=data/photos
PHOTO_URL_PREFIX=/v1/media/photos

# Vehicles per user.
MAX_VEHICLES_PER_USER=3

# Set to true only behind a reverse proxy that sets X-Forwarded-For. Affects per-IP rate limits.
TRUST_PROXY_HEADERS=false

# pgx pool
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m

# HTTP server
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
