# Copy to .env for local runs. .env is gitignored.

APP_NAME=carpool
PORT=8080
DEV_MODE=true

# Local Postgres from docker-compose.yml. The app container uses hostname "postgres" instead of localhost.
DATABASE_URL=postgres://carpool:carpool@localhost:5432/carpool?sslmode=disable

# Replace these before any shared or production deployment. Minimum length is 16 characters.
JWT_SECRET=replace-with-a-long-random-string
OTP_HMAC_SECRET=replace-with-a-different-long-random-string
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Apply SQL migrations when the process starts. docker-compose sets this to true.
MIGRATE_ON_START=false

# pgx pool
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m

# HTTP server
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
