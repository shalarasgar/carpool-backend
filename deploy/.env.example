# Copy to deploy/.env on the server (gitignored) and fill in every secret.
# Generate each secret separately:  openssl rand -hex 32
# DEV_MODE, TRUST_PROXY, MIGRATE_ON_START, MEDIA_DIR, PORT and DATABASE_URL are set
# in docker-compose.yml and cannot be overridden here.

API_DOMAIN=api.yolugra.tech
SITE_DOMAIN=yolugra.tech

APP_NAME=Ýolugra

# Hex only: it is placed into the database URL without escaping.
POSTGRES_PASSWORD=
JWT_SECRET=
OTP_HMAC_SECRET=
ADMIN_TOKEN=

# Must stay empty in production: listed numbers skip every OTP rate limit.
OTP_TEST_PHONES=
# Fill only while a Google Play review is in progress (see the main README).
OTP_REVIEW_PHONE=
OTP_REVIEW_CODE=

# Push: put the Firebase key into ../secrets/ and name it here, e.g. /secrets/fcm.json.
# Empty turns pushes off.
FCM_CREDENTIALS_FILE=

# Everything else in ../.env.example has a working default and may be added here.
