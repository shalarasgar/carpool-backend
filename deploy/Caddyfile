# Caddy obtains and renews Let's Encrypt certificates for both names on its own.
# Both DNS A records must point at this server before the first start.

{$API_DOMAIN} {
	encode zstd gzip
	# Photo uploads are capped at 5 MB by the API; leave room for the multipart envelope.
	request_body {
		max_size 6MB
	}
	# Caddy replaces any client-sent X-Forwarded-For with the real peer address,
	# so the API's TRUST_PROXY reads an address the client cannot forge.
	reverse_proxy api:8080
}

# Public site (privacy policy, account deletion). Copy ../website/public into ./site.
{$SITE_DOMAIN} {
	encode zstd gzip
	root * /srv/site
	file_server
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Admin panel (Flutter web). Copy ../../admin_yolugra/build/web into ./admin.
# It calls its own origin, so the admin API and profile photos are proxied here
# and the API needs no CORS.
{$ADMIN_DOMAIN} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	@api path /admin/v1/* /media/*
	handle @api {
		reverse_proxy api:8080
	}
	handle {
		root * /srv/admin
		# File names carry no build hash, so the browser must ask on every load whether a
		# file changed (a cheap 304 when it did not); otherwise it keeps an old build.
		header Cache-Control "no-cache"
		# Section addresses (/users, /reports/...) are app routes: serve index.html.
		try_files {path} /index.html
		file_server
	}
}
